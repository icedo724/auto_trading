# 이 파일을 .env 로 복사해서 채우세요.  cp .env.example .env
# .env 는 .gitignore 에 있으니 절대 커밋되지 않습니다.
# ※ 키가 유출되면 타인이 내 계좌로 주문할 수 있습니다.

# --- 한국투자증권 KIS Open API (실전 주문/실시간 시세용) ---
# 발급: https://apiportal.koreainvestment.com  (계좌 개설 후 API 신청)
# 모의투자는 실전과 키가 다르게 발급됩니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=            # 예: 12345678-01
KIS_ENV=paper              # paper=모의투자 / real=실전

# --- pykrx (선택) ---
# 없어도 익명 세션으로 동작하지만, 설정하면 KRX 요청 제한에 덜 걸립니다.
KRX_ID=
KRX_PW=

# --- 알림 (선택) ---
# 텔레그램 @BotFather 에서 봇 생성 후 토큰 발급
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
